{
  "manifest_version": 3,
  "name": "Miliorbit",
  "short_name": "Miliorbit",
  "version": "0.1.0",
  "description": "Twoja orbita: znajomi i okolica. Pożyczaj, kupuj, wynajmuj i wystawiaj z komputera.",
  "default_locale": "pl",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Miliorbit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "app/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
