{
  "name": "whatsthat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Miliorbit — mikro-wynajem, pożyczanie, wymiana i sprzedaż najpierw w kręgu znajomych, potem lokalnie.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/build-site.mjs",
    "build:preview": "vite build --mode preview",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "build:extension": "npm run build && node scripts/build-extension.mjs",
    "safari:extension": "npm run build:extension && xcrun safari-web-extension-converter extension --app-name Miliorbit --bundle-identifier com.miliorbit.extension"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
