<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Linki https://miliorbit.com/l/…, /u/…, /z/…, /sos, /zastrzez otwierają aplikację (App Links).
                 Weryfikacja: site/.well-known/assetlinks.json z odciskiem certyfikatu. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="miliorbit.com" />
                <data android:pathPrefix="/l/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/z/" />
                <data android:path="/sos" />
                <data android:path="/zastrzez" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Uprawnienia. System pyta o nie dopiero, gdy funkcja jest potrzebna. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- okolica przy rejestracji i dokładne położenie przy SOS / „Odprowadź mnie” -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- zdjęcia do ogłoszeń, protokół wydania, zdjęcie ceny na stacji -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- wibracja przy uruchomieniu SOS -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
